        "Outlier Analysis"
      ],
      "metadata": {
        "id": "guyoyI8GuDSu"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "An outlier is not automatically an error. It may represent a genuine and important event."
      ],
      "metadata": {
        "id": "CK8gC7p0C5ka"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "Q1 = 25th percentile.\n",
        "Q3 = 75th percentile.\n",
        "IQR = the middle 50% spread of the data."
      ],
      "metadata": {
        "id": "3FfqzOLXGClF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "closure = np.array([10, 19, 12, 13, 14, 80])\n",
        "print(np.mean(closure))\n",
        "\n",
        "# calculate quartiles\n",
        "\n",
        "Q1 = np.percentile(closure, 25)\n",
        "Q3 = np.percentile(closure, 75)\n",
        "\n",
        "IQR = Q3 - Q1\n",
        "print(IQR)\n",
        "\n",
        "# calculate outlier boundaries\n",
        "\n",
        "lower_limit = Q1 - 1.5 * IQR\n",
        "upper_limit = Q3 + 1.5 * IQR\n",
        "\n",
        "print(\"Lower Limit\", lower_limit)\n",
        "print(\"Upper Limit\", upper_limit)\n",
        "\n",
        "# identify outliers\n",
        "\n",
        "Outliers = closure[(closure<lower_limit) | (closure>upper_limit)]  # (|) is an OR symbol\n",
        "print(\"Outliers\", Outliers)"
      ],
