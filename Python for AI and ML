        "import numpy as np, datetime\n",
        "def grade(topic, task, got, expected, out_of=10):\n",
        "    ok = np.allclose(got, expected)\n",
        "    score = out_of if ok else 0\n",
        "    print(\"✅ Correct\" if ok else \"❌ Not yet\", \"-\", task)\n",
        "    print(f\"TRK|{topic}|{task}|{score}|{datetime.date.today()}\")\n",
        "\n",
        "# example:\n",
        "# grade(\"numpy\", \"Reshape\", arr.reshape(2,3), [[1,2,3],[4,5,6]])"
      ]
