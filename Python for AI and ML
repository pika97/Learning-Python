        "Q1 = np.percentile(values, 25)\n",
        "Q3 = np.percentile(values, 75)\n",
        "IQR = Q3 - Q1\n",
        "lower = Q1 - 1.5*IQR\n",
        "upper = Q3 + 1.5*IQR\n",
        "Outlier = values[(values<lower)|(values>upper)]\n",
        "print(\"Outlier\", Outlier)"
